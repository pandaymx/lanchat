{
  "schemaVersion": "1.7",
  "description": "LANChat daemon <-> 五端 UI 契约（JSON-RPC 2.0）。唯一真源为 internal/appapi；禁止任何端使用本文件之外的方法、事件或字段。",
  "transport": {
    "protocol": "jsonrpc-2.0",
    "desktop": {
      "windows": "named-pipe",
      "linux": "unix-socket",
      "macos": "unix-socket"
    },
    "mobile": {
      "ios": "gomobile-xcframework",
      "android": "gomobile-aar"
    }
  },
  "requests": {
    "GetState": {
      "params": [],
      "result": {
        "type": "State",
        "fields": {
          "conn": "ConnState",
          "server": "string?",
          "selfId": "string?",
          "nickname": "string",
          "peers": "Peer[]",
          "transfers": "Transfer[]",
          "channels": "Channel[]",
          "messages": "ChatMessage[]?",
          "voiceCall": "VoiceCallState?",
          "screenShare": "ScreenShareState?"
        }
      }
    },
    "Connect": {
      "params": { "addr": "string", "psk": "string" },
      "result": {}
    },
    "BrowseServers": {
      "params": [],
      "result": { "type": "Server[]" }
    },
    "SendText": {
      "params": { "to": "string", "text": "string", "group": "string?" },
      "result": { "msgID": "string" }
    },
    "SendSticker": {
      "params": { "to": "string", "path": "string" },
      "result": { "msgID": "string" }
    },
    "OfferFile": {
      "params": { "to": "string", "path": "string" },
      "result": { "transferID": "string" }
    },
    "OfferFileToGroup": {
      "params": { "group": "string", "path": "string" },
      "result": { "transferID": "string" }
    },
    "RespondFile": {
      "params": { "transferID": "string", "accept": "bool", "dest": "string" },
      "result": {}
    },
    "PauseFile": {
      "params": { "transferID": "string" },
      "result": {}
    },
    "ResumeFile": {
      "params": { "transferID": "string" },
      "result": {}
    },
    "CancelFile": {
      "params": { "transferID": "string" },
      "result": {}
    },
    "SetNickname": {
      "params": { "name": "string" },
      "result": {}
    },
    "PickDownloadDir": {
      "params": { "path": "string" },
      "result": {}
    },
    "ChannelCreate": {
      "params": { "name": "string", "topic": "string?", "private": "bool?" },
      "result": { "channelID": "string" }
    },
    "ChannelJoin": {
      "params": { "channelID": "string" },
      "result": {}
    },
    "ChannelInvite": {
      "params": { "channelID": "string", "memberID": "string" },
      "result": {}
    },
    "ChannelLeave": {
      "params": { "channelID": "string" },
      "result": {}
    },
    "ChannelList": {
      "params": [],
      "result": { "type": "Channel[]" }
    },
    "StartVoiceCall": {
      "params": { "to": "string?", "group": "string?" },
      "result": { "status": "string" }
    },
    "AcceptVoiceCall": {
      "params": { "to": "string?", "group": "string?", "remoteUDP": "string?" },
      "result": { "status": "string" }
    },
    "StopVoiceCall": {
      "params": { "to": "string?", "group": "string?" },
      "result": {}
    },
    "StartScreenShare": {
      "params": { "to": "string?", "group": "string?", "fps": "int?" },
      "result": { "status": "string" }
    },
    "StopScreenShare": {
      "params": { "to": "string?", "group": "string?" },
      "result": {}
    },
    "SendScreenAnnotation": {
      "params": { "to": "string?", "group": "string?", "normX": "float64", "normY": "float64", "note": "string?" },
      "result": {}
    },
    "SyncFolder": {
      "params": { "to": "string?", "group": "string?", "dirPath": "string" },
      "result": { "synced": "int" }
    },
    "IssueTrustCert": {
      "params": { "subject": "string", "org": "string?", "ttlSec": "int64?" },
      "result": { "token": "string" }
    },
    "VerifyTrustCert": {
      "params": { "token": "string", "rootPub": "string" },
      "result": { "identity": "string" }
    },
    "RunNetworkDiagnostics": {
      "params": [],
      "result": { "report": "string" }
    },
    "RevokeMessage": {
      "params": { "to": "string?", "group": "string?", "msgID": "string" },
      "result": {}
    },
    "ReactMessage": {
      "params": { "to": "string?", "group": "string?", "msgID": "string", "emoji": "string" },
      "result": {}
    },
    "EditMessage": {
      "params": { "to": "string?", "group": "string?", "msgID": "string", "newText": "string" },
      "result": {}
    },
    "PinMessage": {
      "params": { "to": "string?", "group": "string?", "msgID": "string" },
      "result": {}
    },
    "MarkMessageRead": {
      "params": { "to": "string?", "group": "string?", "msgID": "string" },
      "result": {}
    },
    "SetSessionE2EE": {
      "params": { "secret": "string?" },
      "result": {}
    },
    "SetAutoClipboard": {
      "params": { "enabled": "bool" },
      "result": {}
    },
    "SetDND": {
      "params": { "enabled": "bool" },
      "result": {}
    },
    "GetHistoryPage": {
      "params": { "convID": "string?", "beforeTS": "int64?", "limit": "int?" },
      "result": { "type": "ChatMessage[]" }
    },
    "VerifyPeerFingerprint": {
      "params": { "peerID": "string?" },
      "result": { "fingerprint": "string" }
    },
    "SendBurnMessage": {
      "params": { "to": "string?", "group": "string?", "text": "string", "ttlSec": "int?" },
      "result": { "msgID": "string" }
    },
    "SyncHistoryWithPeer": {
      "params": { "to": "string?", "group": "string?", "sinceTS": "int64?" },
      "result": { "synced": "int" }
    },
    "SetBandwidthLimit": {
      "params": { "limitMBps": "float64" },
      "result": { "status": "string" }
    },
    "CheckSilentUpdate": {
      "params": { "proxy": "string?", "download": "bool" },
      "result": { "status": "string" }
    },
    "ChannelManageMember": {
      "params": { "channelID": "string", "memberID": "string?", "action": "string" },
      "result": {}
    },
    "EnqueueOfflineMailbox": {
      "params": { "to": "string", "text": "string", "recipientPub": "string?" },
      "result": { "msgID": "string" }
    },
    "DrainOfflineMailbox": {
      "params": { "fromPeer": "string?" },
      "result": { "status": "string" }
    },
    "PairDevice": {
      "params": { "action": "string", "code": "string?", "peerID": "string?" },
      "result": { "status": "string" }
    },
    "ListPairedDevices": {
      "params": { "filter": "string?" },
      "result": { "devices": "string" }
    },
    "ManageChannelWebhook": {
      "params": { "channelID": "string", "action": "string", "name": "string?", "listenAddr": "string?" },
      "result": { "status": "string" }
    },
    "ExportHistoryArchive": {
      "params": { "destPath": "string", "passphrase": "string" },
      "result": { "status": "string" }
    },
    "ImportHistoryArchive": {
      "params": { "srcPath": "string", "passphrase": "string" },
      "result": { "status": "string" }
    }
  },
  "notifications": {
    "conn.changed": {
      "payload": { "state": "ConnState", "reason": "string" }
    },
    "peer.joined": {
      "payload": { "peer": "Peer" }
    },
    "peer.left": {
      "payload": { "peerId": "string" }
    },
    "msg.received": {
      "payload": {
        "from": "string",
        "group": "string?",
        "msgId": "string",
        "type": "string",
        "text": "string"
      }
    },
    "msg.updated": {
      "payload": {
        "message": "ChatMessage"
      }
    },
    "transfer.progress": {
      "payload": { "transfer": "Transfer" }
    },
    "transfer.done": {
      "payload": { "transferId": "string" }
    },
    "transfer.failed": {
      "payload": { "transferId": "string", "reason": "string" }
    },
    "group.matrix": {
      "payload": {
        "groupId": "string",
        "transferId": "string",
        "haveBitmap": "bytes"
      }
    },
    "channel.updated": {
      "payload": { "channels": "Channel[]" }
    },
    "call.state": {
      "payload": { "call": "VoiceCallState" }
    },
    "screen.frame": {
      "payload": {
        "from": "string",
        "group": "string?",
        "fps": "int",
        "frameData": "string"
      }
    }
  },
  "enums": {
    "ConnState": ["disconnected", "connecting", "connected", "auth_failed"],
    "TransferState": ["pending", "active", "paused", "done", "failed", "canceled"],
    "TransferDirection": ["inbound", "outbound"],
    "PathKind": ["unicast", "swarm", "channel"]
  },
  "types": {
    "Peer": {
      "id": "string",
      "nickname": "string",
      "os": "string",
      "status": "string"
    },
    "Server": {
      "name": "string",
      "id": "string",
      "addr": "string",
      "version": "string",
      "authMode": "string"
    },
    "Transfer": {
      "id": "string",
      "direction": "TransferDirection",
      "state": "TransferState",
      "kind": "PathKind",
      "peerId": "string?",
      "groupId": "string?",
      "name": "string",
      "size": "int64",
      "bytesDone": "int64",
      "speedBps": "int64",
      "viaRelay": "bool",
      "errorReason": "string?"
    },
    "Channel": {
      "id": "string",
      "name": "string",
      "ownerId": "string",
      "private": "bool?",
      "topic": "string?",
      "members": "string[]",
      "admins": "string[]?",
      "muted": "string[]?",
      "announcementAck": "string[]?"
    },
    "ChatMessage": {
      "id": "string",
      "from": "string",
      "to": "string?",
      "group": "string?",
      "type": "string",
      "text": "string",
      "replyTo": "string?",
      "replyQuote": "string?",
      "mentions": "string[]?",
      "reactions": "map<string,string[]>?",
      "editedAt": "int64?",
      "pinned": "bool?",
      "mediaMime": "string?",
      "mediaPath": "string?",
      "revoked": "bool?",
      "readBy": "string[]?",
      "ts": "int64"
    },
    "VoiceCallState": {
      "state": "string",
      "peerId": "string?",
      "groupId": "string?",
      "localAddr": "string?",
      "remoteAddr": "string?",
      "framesIn": "int64?",
      "framesOut": "int64?"
    },
    "ScreenShareState": {
      "active": "bool",
      "peerId": "string?",
      "groupId": "string?",
      "fps": "int?",
      "latestFrame": "string?",
      "annotX": "float64?",
      "annotY": "float64?",
      "annotNote": "string?",
      "annotTs": "int64?"
    }
  }
}
