package templates

// base 是整个页面的 HTML shell：head（含 htmx / CSS）+ 主体容器。
//
// 关键点：
//   - hx-ext="sse" 让 htmx 的 SSE 扩展接管当前容器
//   - hx-sse="connect:/events" 声明 SSE 源路由
//   - 两个脚本走 /assets/ 前缀（由 internal/webui/assets.go 的 embed.FS 提供）
templ base(meta PageMeta) {
	<!DOCTYPE html>
	<html lang="zh-CN">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ meta.Title }</title>
			<link rel="stylesheet" href="/assets/style.css"/>
			<script src="/assets/htmx.min.js" defer></script>
			<script src="/assets/htmx-sse.js" defer></script>
		</head>
		<body>
			<div class="app" hx-ext="sse" hx-sse="connect:/events">
				{ children... }
			</div>
		</body>
	</html>
}
