// home 是主页面：三栏 IM 布局（功能栏 / 会话列表 / 聊天区）。
//
// 布局（仿新版 QQ / 豆包客户端）：
//   - 左 44px 功能栏（rail）：会话 / 联系人占位 / 主题切换
//   - 中 220px 会话列表（sidebar）：默认会话 + 在线成员（presence 帧整段 swap）
//   - 右聊天区（chat）：顶栏（会话名 + 在线数 + 连接状态）→ 消息流 → 输入区
//
// HTMX 集成点（与 M4 一致）：
//   - <ul id="messages"> 是 SSE 推送的 swap 目标
//   - <form class="composer-form" hx-post="/messages"> 由 HTMX 发 AJAX POST
//   - <div id="peers"> 在 sidebar 内，presence 帧整段 innerHTML swap
package templates

import (
	"html"
	"net/url"
	"strconv"
	"strings"

	"github.com/pandaymx/lanchat/pkg/protocol"
)

templ Home(data HomeData) {
	@base(data.Meta) {
		// ---- 左功能栏 ----
		<nav class="rail">
			<button class="rail-btn active" title={ T(data.Tr, "web.nav.chats") }>💬</button>
			<button class="rail-btn" title={ T(data.Tr, "web.nav.contacts") }>👥</button>
			<div class="rail-spacer"></div>
			<button id="settings-btn" class="rail-btn" title={ T(data.Tr, "web.settings") }>⚙</button>
			<button id="theme-toggle" class="rail-btn" title={ T(data.Tr, "web.theme.toggle") }>🌙</button>
		</nav>
		// ---- v1.3 设置面板（主题 / 强调色）----
		<div id="settings-panel" class="settings-panel" hidden>
			<div class="settings-title">{ T(data.Tr, "web.settings") }</div>
			<div class="settings-label">{ T(data.Tr, "web.theme.label") }</div>
			<div class="theme-row" id="theme-row">
				<button type="button" class="theme-choice" data-theme-choice="system">{ T(data.Tr, "web.theme.system") }</button>
				<button type="button" class="theme-choice" data-theme-choice="light">{ T(data.Tr, "web.theme.light") }</button>
				<button type="button" class="theme-choice" data-theme-choice="dark">{ T(data.Tr, "web.theme.dark") }</button>
			</div>
			<div class="settings-label">{ T(data.Tr, "web.accent.label") }</div>
			<div class="accent-grid" id="accent-grid">
				<button type="button" class="accent-dot blue" data-accent-choice="blue" title={ T(data.Tr, "web.accent.blue") }></button>
				<button type="button" class="accent-dot green" data-accent-choice="green" title={ T(data.Tr, "web.accent.green") }></button>
				<button type="button" class="accent-dot purple" data-accent-choice="purple" title={ T(data.Tr, "web.accent.purple") }></button>
				<button type="button" class="accent-dot orange" data-accent-choice="orange" title={ T(data.Tr, "web.accent.orange") }></button>
				<button type="button" class="accent-dot pink" data-accent-choice="pink" title={ T(data.Tr, "web.accent.pink") }></button>
			</div>
		</div>
		// ---- 会话列表 ----
		<aside class="sidebar">
			<div class="sidebar-title">
				{ T(data.Tr, "web.nav.chats") }
				// M12-A：建群入口。点击展开内联表单（标题 + 成员多选），
				// hx-post /conversations 建群后整页跳到新群。
				<button id="conv-create-btn" class="conv-create-btn" type="button" title={ T(data.Tr, "web.group.create") }>＋</button>
			</div>
			// v1.1 消息搜索：Enter 触发 GET /search?q=…，结果整段 innerHTML
			// 进 #search-panel（点外部 / Esc 关闭）。交互逻辑见 app.js bindSearch。
			<div class="search-box">
				<input id="search-input" type="search" placeholder={ T(data.Tr, "web.search.placeholder") } autocomplete="off"/>
			</div>
			<div id="search-panel" class="search-panel" hidden></div>
			// 会话列表：首屏服务端渲染（带当前高亮）；SSE conversations
			// 帧整段 innerHTML swap 进 #conv-list（高亮由 app.js 补）。
			<div id="conv-list" hx-sse="swap:conversations" hx-swap="innerHTML">
				@ConvList(data.Tr, data.Convs, data.ConvID)
			</div>
			// M12-A：建群内联表单（默认折叠；点 + 展开）。
			<form id="conv-create-form" class="conv-create-form" hx-post="/conversations" hx-swap="none" hx-on::after-request="this.reset();this.classList.add('hidden')" hidden>
				<input name="title" placeholder={ T(data.Tr, "web.group.title") } required/>
				<div class="conv-create-members">
					// 成员多选：从在线成员勾选（自己恒在群里，不用选）。
					for _, p := range data.Peers {
						if !p.Self {
							<label class="conv-member-opt">
								<input type="checkbox" name="members" value={ p.User }/>
								<span>{ p.User }</span>
							</label>
						}
					}
				</div>
				<button type="submit" class="send-btn">{ T(data.Tr, "web.group.create") }</button>
			</form>
			<div class="sidebar-title">{ T(data.Tr, "web.peers.title") }</div>
			// 在线成员：SSE presence 帧整段 swap（M7.2 语义不变，容器换到侧栏）。
			<div id="peers" hx-sse="swap:presence" hx-swap="innerHTML">
				@Peers(data.Tr, data.Peers)
			</div>
			// 当前账号：user@device（多个设备同时在线时能分辨自己是哪台）。
			<div class="sidebar-foot">{ data.Meta.Who() }</div>
		</aside>
		// v1.4 移动端：会话抽屉的遮罩（≤720px 时显示，点击关闭抽屉）。
		<div id="sidebar-mask" class="sidebar-mask" hidden></div>
		// ---- 聊天主区 ----
		<main class="chat">
			<header class="chat-head">
				<div class="chat-head-left">
					<span class="avatar chat-avatar" style={ avatarBG(data.ConvTitle) }>{ AvatarChar(data.ConvTitle) }</span>
					<div>
						<div class="chat-title">{ data.ConvTitle }</div>
						<div class="chat-sub">
							if data.Connected {
								<span class="dot online"></span>
							} else {
								<span class="dot offline"></span>
							}
							{ onlineText(data.Tr, data.OnlineCount()) }
						</div>
					</div>
				</div>
				// 连接状态区：SSE state 帧整段 swap（断连出 banner，重连清空）。
				<div id="conn-state" hx-sse="swap:state" hx-swap="innerHTML">
					@ConnStatus(data.Tr, data.Connected)
				</div>
				// v1.2 备份导出：同源直链下载（hub 与 Web 同端口）。
				// QQ 风顶栏工具组：导出备份 + 退出群（SVG 图标）。
				<div class="chat-tools">
					<a class="chat-tool-btn export-link" href="/api/export" download title={ T(data.Tr, "web.export") }>
						<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
					</a>
					if data.ConvMember && data.ConvID != "" {
						<form class="conv-leave-form" hx-post={ "/conversations/" + data.ConvID + "/leave" } hx-swap="none">
							<button type="submit" class="chat-tool-btn conv-leave-btn" title={ T(data.Tr, "web.group.leave") }>
								<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
							</button>
						</form>
					}
				</div>
			</header>
			// 正在输入指示条：SSE typing 帧 innerHTML swap（M7.3）。
			<div id="typing" hx-sse="swap:typing" hx-swap="innerHTML"></div>
			if data.Error != "" {
				<div class="banner">{ data.Error }</div>
			}
			<ul id="messages" class="messages" hx-sse="swap:message" hx-swap="beforeend">
				if data.HasMore {
					@LoadMore(data.Tr, HistoryHref(data.OldestSeq))
				}
				if len(data.Messages) == 0 {
					<li class="empty">{ T(data.Tr, "web.messages.empty") }</li>
				} else {
					for _, m := range data.Messages {
						@Message(m)
					}
				}
			</ul>
			// Enter 发送、Shift+Enter 换行；isComposing 保护中文输入法组词期间的 Enter。
			// requestSubmit() 触发原生 submit 事件，htmx 照常拦截成 AJAX POST；
			// input 事件做高度自适应（上限 200px），发送后 after-request reset 复原。
			// M7.3：textarea 上挂 typing 上发——leading throttle，首个 input 立即
			// 发，之后 3s 最多一次；空 body 不触发；停止输入后靠对端 TTL 消失。
			<footer class="composer">
				<button id="file-btn" type="button" class="composer-file" title={ T(data.Tr, "web.file.upload") }>
					<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"></path></svg>
				</button>
				// v1.3 语音消息：点击开始/停止录音，停止后经文件通道自动发送。
				<button id="voice-btn" type="button" class="composer-voice" title={ T(data.Tr, "web.voice.start") }>
					<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"></path><path d="M19 10v2a7 7 0 0 1-14 0v-2"></path><line x1="12" y1="19" x2="12" y2="23"></line><line x1="8" y1="23" x2="16" y2="23"></line></svg>
				</button>
				<div id="voice-rec" class="voice-rec" hidden>
					<span class="voice-rec-dot"></span>
					<span id="voice-rec-time">0:00</span>
					<button id="voice-cancel" type="button" class="voice-rec-cancel">{ T(data.Tr, "web.voice.cancel") }</button>
					<button id="voice-stop" type="button" class="voice-rec-send">{ T(data.Tr, "web.voice.stop") }</button>
				</div>
				<input id="file-input" type="file" style="display:none"/>
				<form class="composer-form" hx-post="/messages" hx-swap="none" hx-on::after-request="this.reset();window.__clearReply&&window.__clearReply()">
					<input type="hidden" name="conv" value={ data.ConvID }/>
					// v1.1 引用回复：reply 是 ReplyRef JSON（app.js 填值）；
					// 空串 = 普通消息。回复条显示「回复 sender: 预览 + ✕」。
					<input type="hidden" name="reply" id="reply-input" value=""/>
					<div id="reply-bar" class="reply-bar" hidden>
						<span class="reply-bar-label"></span>
						<button type="button" class="reply-bar-cancel" title={ T(data.Tr, "web.reply.cancel") }>✕</button>
					</div>
					<textarea
						name="body"
						placeholder={ T(data.Tr, "web.composer.placeholder") }
						rows="1"
						hx-on:keydown="if(event.key==='Enter'&&!event.shiftKey&&!event.isComposing){event.preventDefault();this.closest('form').requestSubmit()}"
						hx-on:input="this.style.height='auto';this.style.height=Math.min(this.scrollHeight,200)+'px'"
						hx-post="/typing"
						hx-vals={ typingVals(data.ConvID) }
						hx-trigger="input[value.trim()!=''] throttle:3s"
						hx-swap="none"
					></textarea>
					<button type="submit" class="send-btn">{ T(data.Tr, "web.composer.send") }</button>
				</form>
			</footer>
		</main>
	}
}

// ConnStatus 是连接状态 banner（SSE state 帧的 swap 片段）。
//
// 断连时渲染提示条；connected 时渲染空内容——重连后 state=connected
// 帧整段 innerHTML swap，banner 被清空。EventSource 自带自动重连，
// 服务端 session 重建（Manager.GetOrCreate 死会话重建）后恢复推流。
templ ConnStatus(tr Translator, connected bool) {
	if !connected {
		<div class="banner offline">{ T(tr, "web.state.disconnected") }</div>
	}
}

// Peers 是侧栏在线成员列表片段（M7.2）：首屏服务端渲染，SSE presence
// 帧到达后整段 innerHTML swap 进 #peers。每次全量重渲——成员列表体量小
// （局域网场景个位到几十），全量 swap 比客户端增量合并简单且不易错乱。
templ Peers(tr Translator, peers []PeerView) {
	<ul class="peer-list">
		if len(peers) == 0 {
			<li class="peer-empty">{ T(tr, "web.peers.empty") }</li>
		} else {
			for _, p := range peers {
				<li class="peer-item">
					<span class="avatar" style={ avatarBG(p.User) }>{ AvatarChar(p.User) }</span>
					<div class="peer-info">
						<div class="peer-name">{ p.User }</div>
						if p.Self {
							<span class="peer-you">{ T(tr, "web.peers.you") }</span>
						}
					</div>
					<span class="dot online"></span>
				</li>
			}
		}
	</ul>
}

// TypingBar 是「正在输入」指示片段（M7.3）：SSE typing 帧 innerHTML swap
// 进 #typing，也由 GET /typing 自刷新 outerHTML 返回。
//
// 非空片段带 hx-get=/typing + load delay 6s：渲染后 6s 自动再拉一次
// 快照——对方持续输入时新 SSE 帧会先到（片段整体被替换、定时器续期）；
// 对方停止输入后 client 快照惰性过期为空，自刷新拿到空片段自行清除。
templ TypingBar(tr Translator, typing []TypingView) {
	if len(typing) > 0 {
		<div class="typing-bar" hx-get="/typing" hx-trigger="load delay:6s" hx-swap="outerHTML">
			<span class="typing-dots">…</span>
			<span class="typing-text">{ TypingText(tr, typing) }</span>
		</div>
	}
}

// onlineText 是「N 人在线」文案（Tf 单参数注入）。
func onlineText(tr Translator, n int) string {
	return Tf(tr, "web.conv.online", strconv.Itoa(n))
}

// ConvList 是会话列表片段（M12-A）：首屏服务端渲染（activeID 命中项加
// active class）+ SSE conversations 帧整段 innerHTML swap 进 #conv-list
// （SSE 时 activeID 传 ""，高亮由 app.js 按当前 ?conv= 补）。
//
// 每项是一个指向 /?conv=<id> 的链接：切换会话 = 整页刷新（HTMX 约束下
// 最简可靠的多会话形态；消息区/输入区由服务端按 conv 渲染）。
templ ConvList(tr Translator, convs []ConvView, activeID string) {
	<ul class="conv-list">
		for _, c := range convs {
			if c.Active || c.ID == activeID {
				<li class="conv-item active" data-conv={ c.ID }>
					<a href={ ConvHref(c.ID) } class="conv-link">
						<span class="avatar conv-avatar" style={ avatarBG(convTitle(c)) }>{ AvatarChar(convTitle(c)) }</span>
						<div class="conv-info">
							<div class="conv-name">{ convTitle(c) }</div>
							if c.Kind == "group" {
								<div class="conv-meta">{ Tf(tr, "web.conv.members", strconv.Itoa(c.MemberCount)) }</div>
							}
						</div>
					</a>
				</li>
			} else {
				<li class="conv-item" data-conv={ c.ID }>
					<a href={ ConvHref(c.ID) } class="conv-link">
						<span class="avatar conv-avatar" style={ avatarBG(convTitle(c)) }>{ AvatarChar(convTitle(c)) }</span>
						<div class="conv-info">
							<div class="conv-name">{ convTitle(c) }</div>
							if c.Kind == "group" {
								<div class="conv-meta">{ Tf(tr, "web.conv.members", strconv.Itoa(c.MemberCount)) }</div>
							}
						</div>
					</a>
				</li>
			}
		}
	</ul>
}

// ConvHref 构造会话链接：空 ID（大厅）→ 根路径，非空 → /?conv=<id>。
func ConvHref(id string) string {
	if id == "" {
		return "/"
	}
	return "/?conv=" + url.QueryEscape(id)
}

// convTitle 返回会话显示名（空标题回退 Lobby）。
func convTitle(c ConvView) string {
	if c.Title != "" {
		return c.Title
	}
	return "Lobby"
}

// SearchResults 是搜索结果面板片段（v1.1）：GET /search 返回它，
// app.js 把 HTML 塞进 #search-panel。每条命中是一个跳转链接：
// 点击整页刷新到该消息所在会话。正文带 <mark> 关键词高亮
//（服务端转义后替换，杜绝 XSS——见 highlightEscaped）。
templ SearchResults(tr Translator, hits []protocol.StoredMessage, q string) {
	if len(hits) == 0 {
		<div class="search-empty">{ T(tr, "web.search.empty") }</div>
	} else {
		<div class="search-count">{ Tf(tr, "web.search.count", strconv.Itoa(len(hits))) }</div>
		for _, m := range hits {
			<div class="search-item">
				<a href={ ConvHref(m.ConversationID) }>
					<span class="search-sender">{ m.SenderUserID }</span>
					<span class="search-body">
						@templ.Raw(highlightEscaped(m.Body, q))
					</span>
					<span class="search-time">{ FormatTime(m.CreatedAt) }</span>
				</a>
			</div>
		}
	}
}

// highlightEscaped 把正文转义后给关键词包 <mark>（v1.1）。
// 顺序很重要：先 html.EscapeString 把用户正文整体转义（<script> 变成
// 实体、不可能注入），再把转义后的关键词串包进 <mark>——关键词本身也
// 是用户输入，同样先转义，因此 <mark> 只会包裹纯文本，不会产生新标签。
func highlightEscaped(body, q string) string {
	escBody := html.EscapeString(body)
	escQ := html.EscapeString(q)
	if escQ == "" {
		return escBody
	}
	return strings.ReplaceAll(escBody, escQ, "<mark>"+escQ+"</mark>")
}

// typingVals 构造 typing 上发的 hx-vals JSON：{"conv":"<id>"}。
// 空 ID（大厅）也要带 conv 字段（值为空串），服务端据此过滤 typing。
func typingVals(convID string) string {
	return `{"conv":"` + strings.ReplaceAll(convID, `"`, `"`) + `"}`
}
