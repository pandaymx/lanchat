package templates

// message 渲染单条消息（<li>）。
//
// 用途有二：
//  1. 首页首次渲染时被 home 循环调用
//  2. SSE 推送新消息时，服务端直接把这一段的 HTML 放进 SSE data 行，
//     由 htmx 的 hx-swap 追加到 #messages 末尾（M4.3 接通）
//
// templ 对 { } 插值自动做 HTML 转义，Body 里的 < > & 不会被当标签解析
// （见 docs/proposals/2026-09-05-m4-web-proposal.md R9：XSS 防护）。
templ Message(m MessageView) {
	<li id={ "msg-" + m.ID }>
		<span class="msg-meta">{ m.AtText }</span>
		if m.Self {
			<span class="msg-sender self">{ m.SenderUser }</span>
		} else {
			<span class="msg-sender">{ m.SenderUser }</span>
		}
		<span class="msg-body">{ m.Body }</span>
	</li>
}

// LoadMore 是「加载更早消息」按钮行（<li>）。
//
// htmx 行为：点击 → GET href → 响应片段（HistoryPage）outerHTML 替换本行。
// 片段 = 更早的消息（升序）+ 可能的新按钮行，替换后按钮仍在列表最顶、
// 新消息接在按钮下方、再接原有列表——视觉上就是"往上长出一段历史"。
// 没有更多时片段不含按钮，本行直接被消息替换，按钮消失。
templ LoadMore(tr Translator, href string) {
	<li class="load-more">
		<button hx-get={ href } hx-swap="outerHTML" hx-target="closest li">
			{ T(tr, "web.history.load_more") }
		</button>
	</li>
}

// HistoryPage 是 GET /history 的响应片段：一批更早消息 + （可能的）新按钮。
//
// nextBefore 是本批最老一条的 ServerSeq，作为下一次翻页游标；
// more=false 时不渲染按钮（已到最早）。
templ HistoryPage(tr Translator, msgs []MessageView, more bool, nextBefore int64) {
	if more {
		@LoadMore(tr, HistoryHref(nextBefore))
	}
	for _, m := range msgs {
		@Message(m)
	}
}
