// message 渲染单条消息（<li class="msg-row">），新版 IM 气泡样式。
//
// 布局：头像 + 消息主体（sender 行 / 气泡 / meta 行）。self 消息由 CSS
// row-reverse 排到头像右侧（自己右蓝、他人左白）。
//
// 用途有二：
//  1. 首页首次渲染时被 home 循环调用
//  2. SSE 推送新消息时，服务端直接把这一段的 HTML 放进 SSE data 行，
//     由 htmx 的 hx-swap 追加到 #messages 末尾（M4.3 接通）
//
// 渲染安全（docs/proposals/2026-09-05-m4-web-proposal.md R9：XSS 防护）：
//   - templ 对 { } 插值自动做 HTML 转义；
//   - M8.2 起消息体是服务端 goldmark 渲染出的 m.HTML（原始 HTML 已被
//     转义成实体，见 templates/markdown.go），经 templ.Raw 注入——
//     Raw 只豁免"渲染结果"，用户原始输入绝不直接进 Raw。
//
// body 容器必须是块级 <div>：goldmark 输出 <p>/<pre>/<ul> 等块级元素，
// 塞进 <span> 会被浏览器隐式闭合、破坏布局（M8.2 观察到的坑）。
package templates

import "strconv"

templ Message(m MessageView) {
	// data-seq / data-self（M8.1）：read SSE 帧到达时 app.js 据此给已读的
	// 自发消息打勾，无需重渲整条列表。
	<li id={ "msg-" + m.ID } class={ msgRowClass(m.Self) } data-seq={ m.Seq } data-self={ m.Self } data-conv={ m.ConvID }>
		<span class="avatar" style={ avatarBG(m.SenderUser) }>{ AvatarChar(m.SenderUser) }</span>
		<div class="msg-main">
			if !m.Self {
				<div class="msg-sender">{ m.SenderUser }</div>
			}
			<div class="msg-bubble">
				// v1.1 引用回复：气泡顶部渲染灰色引用块（发送者 + 正文预览）。
				// 快照来自发送端 ReplyRef，无需查库；坏引用（被删/不存在）
				// 也照常渲染——局域网轻量模型，不校验引用有效性。
				if m.Reply != nil {
					<div class="msg-reply">
						<span class="msg-reply-who">{ m.Reply.SenderUserID }</span>
						<span class="msg-reply-body">{ m.ReplyPreview() }</span>
					</div>
				}
				<div class="msg-body">@templ.Raw(m.HTML)
</div>
				if m.HasFile() {
					if m.IsImage() {
						<div class="msg-file image">
							<a href={ "/api/files/" + m.File.FileID } target="_blank" rel="noopener">
								<img src={ "/api/files/" + m.File.FileID } alt={ m.File.Name } loading="lazy" />
							</a>
							<span class="msg-file-name">{ m.File.Name }</span>
						</div>
					} else {
						<div class="msg-file">
							<a class="msg-file-link" href={ "/api/files/" + m.File.FileID } download={ m.File.Name }>
								📎 { m.File.Name }
							</a>
							<span class="msg-file-size">{ m.FileSizeText() }</span>
						</div>
					}
				}
			</div>
			// meta 行：时间 + 已读双勾（M8.1）+ 回复按钮（v1.1）。
			// 按钮只带 data 属性、不做行为：app.js 统一委托监听，点击后
			// 把引用快照填进 composer 的回复条（见 app.js bindReplyButtons）。
			<div class="msg-meta">
				{ m.AtText }
				if m.Self && m.Read {
					<span class="msg-read">✓✓</span>
				}
				<button
					class="msg-reply-btn"
					type="button"
					title={ T(nil, "reply") }
					data-reply-id={ m.ID }
					data-reply-sender={ m.SenderUser }
					data-reply-body={ m.ReplyBodyShort() }
				>↩</button>
			</div>
		</div>
	</li>
}

// LoadMore 是「加载更早消息」按钮行（<li>）。
//
// htmx 行为：点击 → GET href → 响应片段（HistoryPage）outerHTML 替换本行。
// 片段 = 更早的消息（升序）+ 可能的新按钮行，替换后按钮仍在列表最顶、
// 新消息接在按钮下方、再接原有列表——视觉上就是"往上长出一段历史"。
// 没有更多时片段不含按钮，本行直接被消息替换，按钮消失。
templ LoadMore(tr Translator, href string) {
	<li class="load-more">
		<button hx-get={ href } hx-swap="outerHTML" hx-target="closest li">
			{ T(tr, "web.history.load_more") }
		</button>
	</li>
}

// HistoryPage 是 GET /history 的响应片段：一批更早消息 + （可能的）新按钮。
//
// nextBefore 是本批最老一条的 ServerSeq，作为下一次翻页游标；
// more=false 时不渲染按钮（已到最早）。
templ HistoryPage(tr Translator, msgs []MessageView, more bool, nextBefore int64) {
	if more {
		@LoadMore(tr, HistoryHref(nextBefore))
	}
	for _, m := range msgs {
		@Message(m)
	}
}

// msgRowClass 是消息行根类：self 时附加 " self"（CSS 控制头像/气泡侧向）。
func msgRowClass(self bool) string {
	if self {
		return "msg-row self"
	}
	return "msg-row"
}

// avatarBG 是头像色块的内联背景（名字哈希色相，浅深主题通用的中间亮度）。
func avatarBG(name string) string {
	return "background:hsl(" + strconv.Itoa(AvatarHue(name)) + " 72% 52%)"
}
