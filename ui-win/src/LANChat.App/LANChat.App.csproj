<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AssemblyName>LANChat</AssemblyName>
    <RootNamespace>LANChat</RootNamespace>
    <!-- MSIX 单项目打包：上架 Microsoft Store，由微软自动重签，无需自有代码签名证书 -->
    <WindowsPackageType>MSIX</WindowsPackageType>
    <!-- 自包含 Windows App SDK：不把运行时作为框架依赖，避免被判为框架包 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppInstallerUri></AppInstallerUri>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <!-- Identity 三项与 Partner Center「产品标识」严格一致 -->
    <AppxPackage>50B5921A.lan-chat</AppxPackage>
    <AppxPublisherId>CN=B072FED8-68F4-4903-9942-BB0A460B36EF</AppxPublisherId>
    <AppxPublisherDisplayName>皮皮萌宝</AppxPublisherDisplayName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LANChat.Launcher\LANChat.Launcher.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 全套应用图标/磁贴资产 -->
    <Content Include="Assets\**\*" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(DaemonPath)')">
    <!-- CI 预先编译好的 Go daemon，作为包内容一并打入 MSIX 根目录 -->
    <Content Include="$(DaemonPath)">
      <Link>lanchat-daemon.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    体积瘦身（MSIX / MSI / Portable ZIP 通用）：
    在生成 .deps.json 及打包前，从 RuntimeCopyLocalItems / NativeCopyLocalItems 中剔除
    LANChat 与 WinUI 3 完全零引用的 .NET BCL 重型库（XML / Data / VB / CSharp / Mail / Quic 等）
    及崩溃转储调试器组件（mscordaccore / mscordbi / DiaSymReader），使 .deps.json 与包体积同步瘦身。
  -->
  <Target Name="PruneUnusedRuntimePackAssets"
          AfterTargets="ResolveRuntimePackAssets;ResolvePackageAssets"
          BeforeTargets="GenerateBuildDependencyFile;GeneratePublishDependencyFile;CopyFilesToOutputDirectory;_ComputeAppxPackagePayload;ComputeFilesToPublish">
    <ItemGroup>
      <RuntimeCopyLocalItems Remove="@(RuntimeCopyLocalItems)"
        Condition="$([System.String]::Copy('%(Filename)').StartsWith('System.Private.Xml')) or
                   $([System.String]::Copy('%(Filename)').StartsWith('System.Xml')) or
                   $([System.String]::Copy('%(Filename)').StartsWith('System.Data')) or
                   $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.VisualBasic')) or
                   $([System.String]::Copy('%(Filename)').StartsWith('System.Private.DataContractSerialization')) or
                   $([System.String]::Copy('%(Filename)').StartsWith('System.Runtime.Serialization')) or
                   '%(Filename)' == 'Microsoft.CSharp' or
                   '%(Filename)' == 'System.Reflection.Metadata' or
                   $([System.String]::Copy('%(Filename)').StartsWith('System.Transactions')) or
                   '%(Filename)' == 'System.Net.HttpListener' or
                   '%(Filename)' == 'System.Net.Mail' or
                   '%(Filename)' == 'System.Net.Quic' or
                   $([System.String]::Copy('%(Filename)').StartsWith('System.Net.WebSockets')) or
                   '%(Filename)' == 'System.Net.WebProxy' or
                   '%(Filename)' == 'System.Net.Requests' or
                   '%(Filename)' == 'System.Net.Security' or
                   '%(Filename)' == 'System.Net.Http' or
                   $([System.String]::Copy('%(Filename)').StartsWith('System.Drawing')) or
                   '%(Filename)' == 'System.Formats.Asn1' or
                   $([System.String]::Copy('%(Filename)').StartsWith('System.Web')) or
                   $([System.String]::Copy('%(Filename)').StartsWith('System.IO.Compression')) or
                   '%(Filename)' == 'System.Linq.Parallel' or
                   '%(Filename)' == 'System.Threading.Tasks.Dataflow'" />
      <NativeCopyLocalItems Remove="@(NativeCopyLocalItems)"
        Condition="$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.DiaSymReader')) or
                   $([System.String]::Copy('%(Filename)').StartsWith('mscordaccore')) or
                   '%(Filename)' == 'mscordbi' or
                   '%(Filename)' == 'createdump' or
                   '%(Filename)' == 'msquic' or
                   '%(Filename)' == 'System.IO.Compression.Native'" />
    </ItemGroup>
  </Target>

  <Target Name="PruneCompileTimeWinmdFromPayload"
          AfterTargets="ComputeFilesToPublish;_ComputeAppxPackagePayload"
          BeforeTargets="_GenerateAppxManifest;_CreateAppxPackage">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.pdb' or '%(Extension)' == '.winmd'" />
      <AppxPackagePayload Remove="@(AppxPackagePayload)"
        Condition="'%(Extension)' == '.pdb' or '%(Extension)' == '.winmd'" />
    </ItemGroup>
  </Target>
</Project>
