<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <AssemblyName>LANChat</AssemblyName>
    <RootNamespace>LANChat</RootNamespace>
    <!-- MSIX 单项目打包：上架 Microsoft Store，由微软自动重签，无需自有代码签名证书 -->
    <WindowsPackageType>MSIX</WindowsPackageType>
    <!-- 自包含 Windows App SDK：不把运行时作为框架依赖，避免被判为框架包 -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppInstallerUri></AppInstallerUri>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <!-- Identity 三项与 Partner Center「产品标识」严格一致 -->
    <AppxPackage>50B5921A.lan-chat</AppxPackage>
    <AppxPublisherId>CN=B072FED8-68F4-4903-9942-BB0A460B36EF</AppxPublisherId>
    <AppxPublisherDisplayName>皮皮萌宝</AppxPublisherDisplayName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250108002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\LANChat.Launcher\LANChat.Launcher.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- 全套应用图标/磁贴资产 -->
    <Content Include="Assets\**\*" />
  </ItemGroup>
  <ItemGroup Condition="Exists('$(DaemonPath)')">
    <!-- CI 预先编译好的 Go daemon，作为包内容一并打入 MSIX 根目录 -->
    <Content Include="$(DaemonPath)">
      <Link>lanchat-daemon.exe</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
