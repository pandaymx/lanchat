<Window
    x:Class="LANChat.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:LANChat.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 未连接：登录页 -->
        <Frame x:Name="LoginFrame" Grid.Row="0" />

        <!-- 已连接：联系人 | 聊天 | 传输 -->
        <Grid x:Name="MainGrid" Grid.Row="0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>
            <views:RosterView Grid.Column="0" />
            <Grid Grid.Column="1">
                <views:ChatView x:Name="ChatViewHost" />
                <views:SettingsView x:Name="SettingsViewHost"
                                    Visibility="{Binding ShowSettings, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
            <views:TransfersView Grid.Column="2" />
        </Grid>

        <ContentPresenter x:Name="FatalErrorHost"
                          Grid.Row="1"
                          Padding="12,8"
                          Visibility="Collapsed" />
    </Grid>
</Window>
