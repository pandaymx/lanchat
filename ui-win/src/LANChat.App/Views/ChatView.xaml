<UserControl
    x:Class="LANChat.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LANChat.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{Binding Chat.ConversationTitle, FallbackValue=选择联系人或频道开始聊天}"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <Button Grid.Column="1"
                        Content="加入频道"
                        FontSize="12"
                        Padding="8,2"
                        Visibility="{Binding Chat.CanJoinChannel, Converter={StaticResource BoolToVisibilityConverter}}"
                        Click="JoinChannelButton_Click" />
                <Button Grid.Column="2"
                        Content="成员"
                        FontSize="12"
                        Padding="8,2"
                        Visibility="{Binding Chat.CurrentChannel, Converter={StaticResource NullToVisibilityConverter}}"
                        Click="MembersButton_Click" />
            </Grid>
        </Border>

        <ListView Grid.Row="1"
                  ItemsSource="{Binding Chat.Messages}"
                  SelectionMode="None"
                  Padding="16,8">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Grid Margin="0,4">
                        <StackPanel HorizontalAlignment="{Binding IsSelf, Converter={StaticResource IsSelf}}"
                                    MaxWidth="440"
                                    Spacing="2">
                            <TextBlock Text="{Binding FromName}"
                                       FontSize="11"
                                       Opacity="0.7"
                                       TextAlignment="{Binding IsSelf, Converter={StaticResource SelfAlignConverter}}" />
                            <Border CornerRadius="10"
                                    Padding="10,7">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding IsSelf, Converter={StaticResource BubbleColorConverter}}" />
                                </Border.Background>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- WinUI 的 Border 继承 Decorator，没有 IsEnabled；禁用状态放在内层 Grid 上 -->
        <Border Grid.Row="2"
                Padding="10,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="8"
                  IsEnabled="{Binding Chat.CanSend}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="文件"
                        Command="{Binding Chat.PickFileCommand}" />
                <TextBox Grid.Column="1"
                         PlaceholderText="输入消息，Enter 发送"
                         Text="{Binding Chat.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="DraftBox_KeyDown" />
                <Button Grid.Column="2"
                        Content="发送"
                        Command="{Binding Chat.SendCommand}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
