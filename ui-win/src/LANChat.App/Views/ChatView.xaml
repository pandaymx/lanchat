<UserControl
    x:Class="LANChat.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LANChat.Models">
    <Grid Background="#F2F3F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：NTQQ 会话头部栏（圆形头像 + 标题 + 在线/P2P 副标题 + 右侧快捷操作） -->
        <Border Grid.Row="0"
                Padding="18,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 目标圆形头像 (40x40 #0099FF + 在线绿点) -->
                <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="20"
                            Background="#0099FF">
                        <TextBlock Text="{Binding Chat.ConversationAvatarText, FallbackValue=💬}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Width="11"
                            Height="11"
                            CornerRadius="6"
                            Background="#22C55E"
                            BorderBrush="White"
                            BorderThickness="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom" />
                </Grid>

                <!-- 会话标题与副标题 -->
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Chat.ConversationTitle, FallbackValue=选择联系人或频道开始聊天}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Chat.ConversationSubtitle}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 右侧快捷操作按钮组 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <Button Content="＋ 加入频道"
                            FontSize="12"
                            Padding="10,4"
                            CornerRadius="6"
                            Background="#0099FF"
                            Foreground="White"
                            Visibility="{Binding Chat.CanJoinChannel, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="JoinChannelButton_Click" />
                    <Button Content="📁 发送文件"
                            FontSize="12"
                            Padding="10,4"
                            CornerRadius="6"
                            IsEnabled="{Binding Chat.CanSend}"
                            Command="{Binding Chat.PickFileCommand}" />
                    <Button Content="➕ 邀请成员"
                            FontSize="12"
                            Padding="10,4"
                            CornerRadius="6"
                            Visibility="{Binding Chat.IsChannelConversation, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="MembersButton_Click" />
                    <Button Content="🚪 退出频道"
                            FontSize="12"
                            Padding="10,4"
                            CornerRadius="6"
                            Visibility="{Binding Chat.IsChannelConversation, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="LeaveChannelButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中部：NTQQ 聊天气泡流（左收白底卡片 + 36x36 圆形头像；右发 #0099FF 蓝底白字 + 36x36 头像 + 已读/回复/撤回） -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Chat.Messages}"
                  SelectionMode="None"
                  Padding="18,12">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Grid Margin="0,6">
                        <!-- 系统提示消息（居中胶囊） -->
                        <Border HorizontalAlignment="Center"
                                Background="#E5E8EF"
                                CornerRadius="10"
                                Padding="12,4"
                                Visibility="{Binding IsSystem, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Text}"
                                       FontSize="11"
                                       Foreground="#646A73"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- 对端发来的消息（左侧：36x36 圆形头像 + 发送者/时间 + 白色气泡 + 回复按钮） -->
                        <Grid HorizontalAlignment="Left"
                              ColumnSpacing="10"
                              MaxWidth="540"
                              Visibility="{Binding IsInbound, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="#0099FF"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding SenderInitial}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding HeaderText}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border CornerRadius="4,12,12,12"
                                        Padding="12,9"
                                        Background="{Binding IsSelf, Converter={StaticResource BubbleColorConverter}}"
                                        BorderBrush="#E5E6EB"
                                        BorderThickness="1">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="↩ 引用回复"
                                                            Tag="{Binding}"
                                                            Click="ReplyMenuFlyoutItem_Click" />
                                            <MenuFlyoutItem Text="👍 点赞回应"
                                                            Tag="{Binding}"
                                                            Click="ReactMenuFlyoutItem_Click" />
                                            <MenuFlyoutItem Text="📌 置顶消息"
                                                            Tag="{Binding}"
                                                            Click="PinMenuFlyoutItem_Click" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <StackPanel Spacing="6">
                                        <Border CornerRadius="8"
                                                MaxWidth="220"
                                                MaxHeight="160"
                                                Visibility="{Binding HasInlineImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Image Source="{Binding CleanText}"
                                                   Stretch="Uniform"
                                                   MaxWidth="220"
                                                   MaxHeight="160" />
                                        </Border>
                                        <TextBlock Text="{Binding DisplayText}"
                                                   FontSize="14"
                                                   Foreground="{Binding IsSelf, Converter={StaticResource BubbleForegroundConverter}}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <!-- 气泡下方的点赞/表情回应胶囊徽章 -->
                                <Border CornerRadius="10"
                                        Padding="8,2"
                                        HorizontalAlignment="Left"
                                        Background="#1F0099FF"
                                        BorderBrush="#470099FF"
                                        BorderThickness="1"
                                        Visibility="{Binding HasReactions, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ReactionsText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#0088EE" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="👍 点赞"
                                            FontSize="11"
                                            Padding="6,1"
                                            CornerRadius="4"
                                            Visibility="{Binding CanReply, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Tag="{Binding}"
                                            Click="ReactMessageButton_Click" />
                                    <Button Content="↩ 回复"
                                            FontSize="11"
                                            Padding="6,1"
                                            CornerRadius="4"
                                            Visibility="{Binding CanReply, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Tag="{Binding}"
                                            Click="ReplyMessageButton_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <!-- 自己发送的消息（右侧：发送者/时间 + #0099FF QQ 蓝气泡白字 + ✓ 已读回执 + 回复/撤回 + 36x36 圆形头像） -->
                        <Grid HorizontalAlignment="Right"
                              ColumnSpacing="10"
                              MaxWidth="540"
                              Visibility="{Binding IsOutbound, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding HeaderText}"
                                           FontSize="11"
                                           HorizontalAlignment="Right"
                                           TextAlignment="{Binding IsSelf, Converter={StaticResource SelfAlignConverter}}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border CornerRadius="12,4,12,12"
                                        Padding="12,9"
                                        HorizontalAlignment="Right"
                                        Background="{Binding IsSelf, Converter={StaticResource BubbleColorConverter}}">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="↩ 引用回复"
                                                            Tag="{Binding}"
                                                            Click="ReplyMenuFlyoutItem_Click" />
                                            <MenuFlyoutItem Text="👍 点赞回应"
                                                            Tag="{Binding}"
                                                            Click="ReactMenuFlyoutItem_Click" />
                                            <MenuFlyoutItem Text="📌 置顶消息"
                                                            Tag="{Binding}"
                                                            Click="PinMenuFlyoutItem_Click" />
                                            <MenuFlyoutItem Text="撤回消息"
                                                            Tag="{Binding}"
                                                            Click="RevokeMenuFlyoutItem_Click" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <StackPanel Spacing="6">
                                        <Border CornerRadius="8"
                                                MaxWidth="220"
                                                MaxHeight="160"
                                                Visibility="{Binding HasInlineImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Image Source="{Binding CleanText}"
                                                   Stretch="Uniform"
                                                   MaxWidth="220"
                                                   MaxHeight="160" />
                                        </Border>
                                        <TextBlock Text="{Binding DisplayText}"
                                                   FontSize="14"
                                                   Foreground="{Binding IsSelf, Converter={StaticResource BubbleForegroundConverter}}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <!-- 气泡下方的点赞/表情回应胶囊徽章 -->
                                <Border CornerRadius="10"
                                        Padding="8,2"
                                        HorizontalAlignment="Right"
                                        Background="#1F0099FF"
                                        BorderBrush="#470099FF"
                                        BorderThickness="1"
                                        Visibility="{Binding HasReactions, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ReactionsText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#0088EE" />
                                </Border>
                                <StackPanel Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            Spacing="8">
                                    <TextBlock Text="{Binding ReadReceiptText}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="#0088EE" />
                                    <Button Content="👍 点赞"
                                            FontSize="11"
                                            Padding="6,1"
                                            CornerRadius="4"
                                            Visibility="{Binding CanReply, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Tag="{Binding}"
                                            Click="ReactMessageButton_Click" />
                                    <Button Content="↩ 回复"
                                            FontSize="11"
                                            Padding="6,1"
                                            CornerRadius="4"
                                            Visibility="{Binding CanReply, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Tag="{Binding}"
                                            Click="ReplyMessageButton_Click" />
                                    <Button Content="撤回"
                                            FontSize="11"
                                            Padding="6,1"
                                            CornerRadius="4"
                                            Visibility="{Binding CanRevoke, Converter={StaticResource BoolToVisibilityConverter}}"
                                            Tag="{Binding}"
                                            Click="RevokeMessageButton_Click" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="#0099FF"
                                    VerticalAlignment="Top">
                                <TextBlock Text="我"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部：NTQQ 风格消息编辑器（工具栏 + 多行输入框 + 右下角 QQ 蓝「发送 (S)」按钮） -->
        <Border Grid.Row="2"
                Padding="14,10,14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel Spacing="8">
                <!-- 工具栏行：😊 表情贴纸 | 📁 发送文件 | 🔐 端到端加密 (/e2ee) | 🔍 搜索记录 -->
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button Content="😊 表情贴纸"
                            FontSize="12"
                            Padding="10,4"
                            CornerRadius="6"
                            IsEnabled="{Binding Chat.CanSend}">
                        <Button.Flyout>
                            <Flyout x:Name="EmojiFlyout" Placement="TopEdgeAlignedLeft">
                                <StackPanel Spacing="10" Width="260">
                                    <TextBlock Text="快捷表情与自定义贴纸"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="😀" Tag="😀" Click="EmojiItem_Click" />
                                        <Button Content="😂" Tag="😂" Click="EmojiItem_Click" />
                                        <Button Content="😍" Tag="😍" Click="EmojiItem_Click" />
                                        <Button Content="😎" Tag="😎" Click="EmojiItem_Click" />
                                        <Button Content="👍" Tag="👍" Click="EmojiItem_Click" />
                                        <Button Content="🎉" Tag="🎉" Click="EmojiItem_Click" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Content="❤️" Tag="❤️" Click="EmojiItem_Click" />
                                        <Button Content="🔥" Tag="🔥" Click="EmojiItem_Click" />
                                        <Button Content="🚀" Tag="🚀" Click="EmojiItem_Click" />
                                        <Button Content="✨" Tag="✨" Click="EmojiItem_Click" />
                                        <Button Content="🤝" Tag="🤝" Click="EmojiItem_Click" />
                                        <Button Content="🙏" Tag="🙏" Click="EmojiItem_Click" />
                                    </StackPanel>
                                    <Button Content="🖼️ 选择本地贴纸图片发送…"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="6"
                                            Background="#0099FF"
                                            Foreground="White"
                                            Command="{Binding Chat.PickStickerCommand}" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button Content="📁 发送文件"
                            FontSize="12"
                            Padding="10,4"
                            CornerRadius="6"
                            IsEnabled="{Binding Chat.CanSend}"
                            Command="{Binding Chat.PickFileCommand}" />

                    <Button Content="🎤 语音"
                            FontSize="12"
                            Padding="10,4"
                            CornerRadius="6"
                            IsEnabled="{Binding Chat.CanSend}"
                            Click="VoiceButton_Click" />

                    <Button Content="{Binding Chat.E2eeButtonText, FallbackValue=🔐 端到端加密 (/e2ee)}"
                            FontSize="12"
                            Padding="10,4"
                            CornerRadius="6"
                            IsEnabled="{Binding Chat.CanSend}"
                            Click="ToggleE2eeButton_Click" />

                    <Button Content="🛡️ 安全码"
                            FontSize="12"
                            Padding="10,4"
                            CornerRadius="6"
                            IsEnabled="{Binding Chat.CanSend}"
                            Click="FingerprintButton_Click" />

                    <Button Content="🔍 搜索记录"
                            FontSize="12"
                            Padding="10,4"
                            CornerRadius="6"
                            IsEnabled="{Binding Chat.HasActiveConversation}">
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedLeft">
                                <StackPanel Spacing="8" Width="240">
                                    <TextBlock Text="搜索当前会话历史消息"
                                               FontSize="12"
                                               FontWeight="SemiBold" />
                                    <TextBox x:Name="SearchHistoryBox"
                                             PlaceholderText="输入要查找的关键词…"
                                             CornerRadius="6" />
                                    <Button Content="立即搜索"
                                            HorizontalAlignment="Stretch"
                                            CornerRadius="6"
                                            Background="#0099FF"
                                            Foreground="White"
                                            Click="SearchMessagesButton_Click" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>

                <!-- 输入框 + 右下角 QQ 蓝「发送 (S)」按钮 -->
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DraftBox"
                             Grid.Column="0"
                             MinHeight="64"
                             MaxHeight="110"
                             TextWrapping="Wrap"
                             CornerRadius="8"
                             PlaceholderText="输入消息，按 Enter 发送（支持表情贴纸、文件直传、/reply 引用、/revoke 撤回、/e2ee 加密）…"
                             IsEnabled="{Binding Chat.CanSend}"
                             Text="{Binding Chat.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="DraftBox_KeyDown" />
                    <Button Grid.Column="1"
                            Content="发送 (S)"
                            Width="96"
                            Height="38"
                            VerticalAlignment="Bottom"
                            CornerRadius="8"
                            FontWeight="SemiBold"
                            Background="#0099FF"
                            Foreground="White"
                            IsEnabled="{Binding Chat.CanSend}"
                            Command="{Binding Chat.SendCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
