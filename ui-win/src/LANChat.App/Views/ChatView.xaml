<UserControl
    x:Class="LANChat.Views.ChatView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LANChat.Models">
    <Grid Background="#F2F3F5"
          AllowDrop="True"
          DragOver="ChatView_DragOver"
          Drop="ChatView_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部：NTQQ 会话头部栏（圆形头像 + 标题 + 在线/P2P 副标题 + 右侧快捷操作） -->
        <Border Grid.Row="0"
                Padding="18,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 目标圆形头像 (40x40 #0099FF + 在线绿点) -->
                <Grid Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="20"
                            Background="#0099FF">
                        <TextBlock Text="{Binding Chat.ConversationAvatarText, FallbackValue=💬}"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Width="11"
                            Height="11"
                            CornerRadius="6"
                            Background="#22C55E"
                            BorderBrush="White"
                            BorderThickness="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Bottom" />
                </Grid>

                <!-- 会话标题与副标题 -->
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Chat.ConversationTitle, FallbackValue=选择联系人或频道开始聊天}"
                               FontSize="16"
                               FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Chat.ConversationSubtitle}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- 右侧快捷操作按钮组 -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center">
                    <Button Content="＋ 加入频道"
                            FontSize="12"
                            Padding="10,4"
                            CornerRadius="6"
                            Background="#0099FF"
                            Foreground="White"
                            Visibility="{Binding Chat.CanJoinChannel, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="JoinChannelButton_Click" />
                    <Button Content="{Binding Chat.VoiceCallButtonText, FallbackValue=📞 语音通话}"
                            FontSize="12"
                            Padding="10,4"
                            CornerRadius="6"
                            IsEnabled="{Binding Chat.CanSend}"
                            Command="{Binding Chat.ToggleVoiceCallCommand}" />
                    <Button Content="📁 发送文件"
                            FontSize="12"
                            Padding="10,4"
                            CornerRadius="6"
                            IsEnabled="{Binding Chat.CanSend}"
                            Command="{Binding Chat.PickFileCommand}" />
                    <Button Content="➕ 邀请成员"
                            FontSize="12"
                            Padding="10,4"
                            CornerRadius="6"
                            Visibility="{Binding Chat.IsChannelConversation, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="MembersButton_Click" />
                    <Button Content="🚪 退出频道"
                            FontSize="12"
                            Padding="10,4"
                            CornerRadius="6"
                            Visibility="{Binding Chat.IsChannelConversation, Converter={StaticResource BoolToVisibilityConverter}}"
                            Click="LeaveChannelButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 中部：NTQQ 聊天气泡流（左收白底卡片 + 36x36 圆形头像；右发 #0099FF 蓝底白字 + 36x36 头像 + 已读/回复/撤回） -->
        <ListView Grid.Row="1"
                  ItemsSource="{Binding Chat.Messages}"
                  SelectionMode="None"
                  Padding="18,12">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ChatMessage">
                    <Grid Margin="0,6">
                        <!-- 系统提示消息（居中胶囊） -->
                        <Border HorizontalAlignment="Center"
                                Background="#E5E8EF"
                                CornerRadius="10"
                                Padding="12,4"
                                Visibility="{Binding IsSystem, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding Text}"
                                       FontSize="11"
                                       Foreground="#646A73"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- QQ 风格撤回消息居中提示条（无头像、无气泡；自己撤回时附带蓝色「重新编辑」按钮） -->
                        <Border HorizontalAlignment="Center"
                                Background="#E8EBF0"
                                CornerRadius="12"
                                Padding="12,4"
                                Visibility="{Binding IsRevokedNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="6"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding RevokeNoticeText}"
                                           FontSize="12"
                                           Foreground="#86909C"
                                           VerticalAlignment="Center" />
                                <Button Content="重新编辑"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Padding="2,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#0099FF"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding CanReEdit, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Tag="{Binding}"
                                        Click="ReEditMessageButton_Click" />
                            </StackPanel>
                        </Border>

                        <!-- 对端发来的消息（左侧：36x36 圆形头像 + 发送者/时间 + 纯净白色圆角气泡 + 右键 QQ 菜单） -->
                        <Grid HorizontalAlignment="Left"
                              ColumnSpacing="10"
                              MaxWidth="540"
                              Visibility="{Binding IsInbound, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="#0099FF"
                                    VerticalAlignment="Top">
                                <TextBlock Text="{Binding SenderInitial}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding HeaderText}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border CornerRadius="4,14,14,14"
                                        Padding="13,10"
                                        Background="{Binding IsSelf, Converter={StaticResource BubbleColorConverter}}"
                                        BorderBrush="#E5E6EB"
                                        BorderThickness="1"
                                        ToolTipService.ToolTip="右键打开消息菜单（点赞 / 回复 / 复制 / 置顶）">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="👍 点赞回应"
                                                            Tag="{Binding}"
                                                            Click="ReactMenuFlyoutItem_Click" />
                                            <MenuFlyoutItem Text="💬 引用回复"
                                                            Tag="{Binding}"
                                                            Click="ReplyMenuFlyoutItem_Click" />
                                            <MenuFlyoutItem Text="📋 复制文本"
                                                            Tag="{Binding}"
                                                            Click="CopyMenuFlyoutItem_Click" />
                                            <MenuFlyoutItem Text="📌 置顶消息"
                                                            Tag="{Binding}"
                                                            Click="PinMenuFlyoutItem_Click" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <StackPanel Spacing="6">
                                        <!-- QQ 气泡内嵌引用回复卡片 -->
                                        <Border Background="#F2F4F7"
                                                CornerRadius="6"
                                                Padding="9,6"
                                                Visibility="{Binding HasQuote, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Width="3"
                                                        CornerRadius="1.5"
                                                        Background="#0099FF" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding QuotedText}"
                                                           FontSize="12"
                                                           Foreground="#646A73"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                        <Border CornerRadius="8"
                                                MaxWidth="220"
                                                MaxHeight="160"
                                                Visibility="{Binding HasInlineImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Image Source="{Binding CleanText}"
                                                   Stretch="Uniform"
                                                   MaxWidth="220"
                                                   MaxHeight="160" />
                                        </Border>
                                        <TextBlock Text="{Binding DisplayText}"
                                                   FontSize="14"
                                                   Foreground="{Binding IsSelf, Converter={StaticResource BubbleForegroundConverter}}"
                                                   IsTextSelectionEnabled="True"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <!-- 气泡下方的点赞/表情回应胶囊徽章（仅当有人点赞时显示） -->
                                <Button Padding="8,2"
                                        CornerRadius="11"
                                        HorizontalAlignment="Left"
                                        Background="#1A0099FF"
                                        BorderBrush="#400099FF"
                                        BorderThickness="1"
                                        Visibility="{Binding HasReactions, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Tag="{Binding}"
                                        Click="ReactMessageButton_Click">
                                    <TextBlock Text="{Binding ReactionsText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#0088EE" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 自己发送的消息（右侧：时间/已读 + #0099FF QQ 蓝气泡白字 + 右键 QQ 菜单 + 36x36 圆形头像） -->
                        <Grid HorizontalAlignment="Right"
                              ColumnSpacing="10"
                              MaxWidth="540"
                              Visibility="{Binding IsOutbound, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="4" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding HeaderText}"
                                           FontSize="11"
                                           HorizontalAlignment="Right"
                                           TextAlignment="{Binding IsSelf, Converter={StaticResource SelfAlignConverter}}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Border CornerRadius="14,4,14,14"
                                        Padding="13,10"
                                        HorizontalAlignment="Right"
                                        Background="{Binding IsSelf, Converter={StaticResource BubbleColorConverter}}"
                                        ToolTipService.ToolTip="右键打开消息菜单（点赞 / 回复 / 复制 / 置顶 / 撤回）">
                                    <Border.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="👍 点赞回应"
                                                            Tag="{Binding}"
                                                            Click="ReactMenuFlyoutItem_Click" />
                                            <MenuFlyoutItem Text="💬 引用回复"
                                                            Tag="{Binding}"
                                                            Click="ReplyMenuFlyoutItem_Click" />
                                            <MenuFlyoutItem Text="📋 复制文本"
                                                            Tag="{Binding}"
                                                            Click="CopyMenuFlyoutItem_Click" />
                                            <MenuFlyoutItem Text="📌 置顶消息"
                                                            Tag="{Binding}"
                                                            Click="PinMenuFlyoutItem_Click" />
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="↩️ 撤回消息"
                                                            Tag="{Binding}"
                                                            Click="RevokeMenuFlyoutItem_Click" />
                                        </MenuFlyout>
                                    </Border.ContextFlyout>
                                    <StackPanel Spacing="6">
                                        <!-- QQ 蓝色气泡内嵌半透明引用回复卡片 -->
                                        <Border Background="#29FFFFFF"
                                                CornerRadius="6"
                                                Padding="9,6"
                                                Visibility="{Binding HasQuote, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Width="3"
                                                        CornerRadius="1.5"
                                                        Background="White" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding QuotedText}"
                                                           FontSize="12"
                                                           Foreground="#F0FFFFFF"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                        <Border CornerRadius="8"
                                                MaxWidth="220"
                                                MaxHeight="160"
                                                Visibility="{Binding HasInlineImage, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Image Source="{Binding CleanText}"
                                                   Stretch="Uniform"
                                                   MaxWidth="220"
                                                   MaxHeight="160" />
                                        </Border>
                                        <TextBlock Text="{Binding DisplayText}"
                                                   FontSize="14"
                                                   Foreground="{Binding IsSelf, Converter={StaticResource BubbleForegroundConverter}}"
                                                   IsTextSelectionEnabled="True"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <!-- 气泡下方的点赞/表情回应胶囊徽章（仅当有人点赞时显示） -->
                                <Button Padding="8,2"
                                        CornerRadius="11"
                                        HorizontalAlignment="Right"
                                        Background="#1A0099FF"
                                        BorderBrush="#400099FF"
                                        BorderThickness="1"
                                        Visibility="{Binding HasReactions, Converter={StaticResource BoolToVisibilityConverter}}"
                                        Tag="{Binding}"
                                        Click="ReactMessageButton_Click">
                                    <TextBlock Text="{Binding ReactionsText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#0088EE" />
                                </Button>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    Width="36"
                                    Height="36"
                                    CornerRadius="18"
                                    Background="#0099FF"
                                    VerticalAlignment="Top">
                                <TextBlock Text="我"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 底部：NTQQ 一体化消息编辑器（顶部引用条 + 无边框图标工具栏 + 多行输入区 + 右下角 QQ 蓝「发送」按钮） -->
        <Border Grid.Row="2"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <!-- QQ 引用回复预览条（仅在点击「引用回复」时展示） -->
                <Border Background="#F0F7FF"
                        BorderBrush="#D6EBFF"
                        BorderThickness="0,0,0,1"
                        Padding="14,6"
                        Visibility="{Binding Chat.HasReplyTarget, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0"
                                Width="3"
                                Height="18"
                                CornerRadius="1.5"
                                Background="#0099FF"
                                VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Chat.ReplyTargetSummary}"
                                   FontSize="12"
                                   Foreground="#0066CC"
                                   VerticalAlignment="Center"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2"
                                Content="✕"
                                FontSize="11"
                                Padding="6,2"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#646A73"
                                ToolTipService.ToolTip="取消引用回复"
                                Click="CancelReplyButton_Click" />
                    </Grid>
                </Border>

                <!-- 顶部无边框轻量图标工具栏 -->
                <Grid Padding="10,6,14,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                        <Button Content="😊 表情"
                                FontSize="12"
                                Padding="8,4"
                                CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="插入 Emoji 表情或发送贴纸"
                                IsEnabled="{Binding Chat.CanSend}">
                            <Button.Flyout>
                                <Flyout x:Name="EmojiFlyout" Placement="TopEdgeAlignedLeft">
                                    <StackPanel Spacing="10" Width="260">
                                        <TextBlock Text="点击表情插入到输入框"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="😀" Tag="😀" Click="EmojiItem_Click" />
                                            <Button Content="😂" Tag="😂" Click="EmojiItem_Click" />
                                            <Button Content="😍" Tag="😍" Click="EmojiItem_Click" />
                                            <Button Content="😎" Tag="😎" Click="EmojiItem_Click" />
                                            <Button Content="👍" Tag="👍" Click="EmojiItem_Click" />
                                            <Button Content="🎉" Tag="🎉" Click="EmojiItem_Click" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Content="❤️" Tag="❤️" Click="EmojiItem_Click" />
                                            <Button Content="🔥" Tag="🔥" Click="EmojiItem_Click" />
                                            <Button Content="🚀" Tag="🚀" Click="EmojiItem_Click" />
                                            <Button Content="✨" Tag="✨" Click="EmojiItem_Click" />
                                            <Button Content="🤝" Tag="🤝" Click="EmojiItem_Click" />
                                            <Button Content="🙏" Tag="🙏" Click="EmojiItem_Click" />
                                        </StackPanel>
                                        <Button Content="🖼️ 选择本地贴纸图片发送…"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="6"
                                                Background="#0099FF"
                                                Foreground="White"
                                                Command="{Binding Chat.PickStickerCommand}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>

                        <Button Content="📁 文件"
                                FontSize="12"
                                Padding="8,4"
                                CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="通过 P2P 高速直连发送文件"
                                IsEnabled="{Binding Chat.CanSend}"
                                Command="{Binding Chat.PickFileCommand}" />

                        <Button Content="📂 文件夹"
                                FontSize="12"
                                Padding="8,4"
                                CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="选择整个文件夹流式传输并在对端自动还原目录树"
                                IsEnabled="{Binding Chat.CanSend}"
                                Click="PickFolderButton_Click" />

                        <Button Content="📋 剪贴板"
                                FontSize="12"
                                Padding="8,4"
                                CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="一键直发剪贴板截图/文件，或通过 /clip 同步剪贴板文本"
                                IsEnabled="{Binding Chat.CanSend}"
                                Click="PasteClipboardButton_Click" />

                        <Button Content="🎤 语音"
                                FontSize="12"
                                Padding="8,4"
                                CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="发送语音消息"
                                IsEnabled="{Binding Chat.CanSend}"
                                Click="VoiceButton_Click" />

                        <Button Content="{Binding Chat.E2eeButtonText, FallbackValue=🔐 加密}"
                                FontSize="12"
                                Padding="8,4"
                                CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="切换端到端加密聊天"
                                IsEnabled="{Binding Chat.CanSend}"
                                Click="ToggleE2eeButton_Click" />

                        <Button Content="🛡️ 安全码"
                                FontSize="12"
                                Padding="8,4"
                                CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="查看并核验本机与对端安全码指纹"
                                IsEnabled="{Binding Chat.CanSend}"
                                Click="FingerprintButton_Click" />

                        <Button Content="🔍 记录"
                                FontSize="12"
                                Padding="8,4"
                                CornerRadius="6"
                                Background="Transparent"
                                BorderThickness="0"
                                ToolTipService.ToolTip="搜索当前会话历史消息"
                                IsEnabled="{Binding Chat.HasActiveConversation}">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedLeft">
                                    <StackPanel Spacing="8" Width="240">
                                        <TextBlock Text="搜索当前会话历史消息"
                                                   FontSize="12"
                                                   FontWeight="SemiBold" />
                                        <TextBox x:Name="SearchHistoryBox"
                                                 PlaceholderText="输入要查找的关键词…"
                                                 CornerRadius="6" />
                                        <Button Content="立即搜索"
                                                HorizontalAlignment="Stretch"
                                                CornerRadius="6"
                                                Background="#0099FF"
                                                Foreground="White"
                                                Click="SearchMessagesButton_Click" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="右键消息气泡可点赞 / 回复 / 撤回"
                               FontSize="11"
                               VerticalAlignment="Center"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Grid>

                <!-- 中部无边框输入区 + 右下角 QQ 蓝「发送」按钮 -->
                <Grid Padding="12,2,14,10" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DraftBox"
                             Grid.Column="0"
                             MinHeight="68"
                             MaxHeight="116"
                             TextWrapping="Wrap"
                             BorderThickness="0"
                             Background="Transparent"
                             PlaceholderText="输入消息，按 Enter 发送…"
                             IsEnabled="{Binding Chat.CanSend}"
                             Text="{Binding Chat.Draft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="DraftBox_KeyDown" />
                    <Button Grid.Column="1"
                            Content="发送"
                            Width="82"
                            Height="34"
                            VerticalAlignment="Bottom"
                            CornerRadius="6"
                            FontWeight="SemiBold"
                            Background="#0099FF"
                            Foreground="White"
                            IsEnabled="{Binding Chat.CanSend}"
                            Command="{Binding Chat.SendCommand}" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
