<Page
    x:Class="LANChat.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LANChat.Models">
    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="LANChat" FontSize="32" FontWeight="SemiBold" />
            <TextBlock Text="连接局域网中心节点"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ManualAddrBox"
                     Grid.Column="0"
                     Header="服务器地址"
                     PlaceholderText="例如 192.168.1.10:9090"
                     Text="{Binding Login.ManualAddr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    VerticalAlignment="Bottom"
                    Margin="8,0,0,0"
                    Content="自动发现"
                    Command="{Binding Login.BrowseCommand}" />
        </Grid>

        <Border Grid.Row="2"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="4">
            <ListView
                ItemsSource="{Binding Login.Servers}"
                SelectedItem="{Binding Login.SelectedServer, Mode=TwoWay}"
                SelectionMode="Single"
                IsItemClickEnabled="False">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ServerInfo">
                        <Grid Padding="8,6" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Addr}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Version}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <Border Grid.Column="2"
                                    Background="{ThemeResource AccentControlElevationFillColorDefaultBrush}"
                                    CornerRadius="4"
                                    Padding="8,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding AuthMode}" FontSize="12" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Border>

        <PasswordBox x:Name="PskBox"
                     Grid.Row="3"
                     Margin="0,12,0,0"
                     Header="口令（PSK）"
                     PlaceholderText="该服务器需要口令时输入"
                     PasswordChanged="PskBox_PasswordChanged" />

        <StackPanel Grid.Row="3" Margin="0,160,0,0" Spacing="10">
            <Button Content="连接"
                    HorizontalAlignment="Stretch"
                    Command="{Binding Login.ConnectCommand}" />
            <ProgressRing IsActive="{Binding Login.IsBusy}"
                          HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Login.StatusMessage}"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
        </StackPanel>
    </Grid>
</Page>
