<Page
    x:Class="LANChat.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LANChat.Models">
    <Grid Background="#F0F4F9">
        <!-- 顶部淡蓝装饰背景带 -->
        <Border Height="220"
                VerticalAlignment="Top"
                Background="#E6F4FF"
                Opacity="0.65" />

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <!-- 居中 NTQQ 风格登录卡片 -->
            <Border Width="440"
                    Margin="24,32"
                    Padding="32,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="16">
                <StackPanel Spacing="18">
                    <!-- 顶部：72x72 圆形 QQ 蓝品牌头像 + 在线绿点 + 标题副标题 -->
                    <StackPanel HorizontalAlignment="Center" Spacing="8">
                        <Grid Width="72" Height="72" HorizontalAlignment="Center">
                            <Border Width="72"
                                    Height="72"
                                    CornerRadius="36"
                                    Background="#0099FF">
                                <TextBlock Text="LC"
                                           FontSize="26"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border Width="18"
                                    Height="18"
                                    CornerRadius="9"
                                    Background="#22C55E"
                                    BorderBrush="White"
                                    BorderThickness="2.5"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Margin="0,0,2,2" />
                        </Grid>

                        <TextBlock Text="LANChat 局域网即时通信"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="P2P 高速直连 · 端到端加密聊天"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 局域网中心节点自动发现卡片 -->
                    <Border Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12,10">
                        <StackPanel Spacing="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="📡 局域网中心节点"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <Button Grid.Column="1"
                                        Content="🔄 自动发现"
                                        FontSize="12"
                                        Padding="10,4"
                                        CornerRadius="6"
                                        Command="{Binding Login.BrowseCommand}" />
                            </Grid>

                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    MinHeight="110"
                                    MaxHeight="156"
                                    Padding="2">
                                <ListView ItemsSource="{Binding Login.Servers}"
                                          SelectedItem="{Binding Login.SelectedServer, Mode=TwoWay}"
                                          SelectionMode="Single"
                                          IsItemClickEnabled="False">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:ServerInfo">
                                            <Grid Padding="8,6" ColumnSpacing="10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0"
                                                        Width="32"
                                                        Height="32"
                                                        CornerRadius="16"
                                                        Background="#E6F4FF"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="🌐"
                                                               FontSize="14"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding AddrWithLinkDisplay}"
                                                               FontSize="11"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding VersionDisplay}"
                                                           FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Border Grid.Column="3"
                                                        Background="#E6F4FF"
                                                        CornerRadius="6"
                                                        Padding="8,3"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding AuthBadgeText}"
                                                               FontSize="11"
                                                               Foreground="#0077CC"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 服务器地址与 PSK 口令输入区 -->
                    <StackPanel Spacing="12">
                        <TextBox x:Name="ManualAddrBox"
                                 Header="中心节点地址"
                                 PlaceholderText="例如 192.168.1.10:9090（支持点击上方节点自动填入）"
                                 CornerRadius="8"
                                 Text="{Binding Login.ManualAddr, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <PasswordBox x:Name="PskBox"
                                     Header="预共享口令（PSK）"
                                     PlaceholderText="输入局域网鉴权口令（免密节点可留空）"
                                     CornerRadius="8"
                                     PasswordChanged="PskBox_PasswordChanged" />
                    </StackPanel>

                    <!-- 全宽圆角 QQ 蓝「立即登录」按钮与状态区 -->
                    <StackPanel Spacing="10" Margin="0,4,0,0">
                        <Button Content="立即登录"
                                Height="42"
                                FontSize="15"
                                FontWeight="SemiBold"
                                CornerRadius="8"
                                Background="#0099FF"
                                Foreground="White"
                                HorizontalAlignment="Stretch"
                                Command="{Binding Login.ConnectCommand}" />

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="8">
                            <ProgressRing Width="18"
                                          Height="18"
                                          IsActive="{Binding Login.IsBusy}" />
                            <TextBlock Text="{Binding Login.StatusMessage}"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource SystemFillColorCautionBrush}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Page>
