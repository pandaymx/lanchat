<UserControl
    x:Class="LANChat.Views.RosterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LANChat.Models"
    xmlns:viewmodels="using:LANChat.ViewModels">
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="14,16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="2">
                    <TextBlock Text="联系人" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="局域网在线用户与频道"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1">
                <StackPanel>
                    <TextBlock Margin="14,12,14,4"
                               Text="联系人"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ListView ItemsSource="{Binding Roster.Peers}"
                              SelectedItem="{Binding Roster.SelectedPeer, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Peer">
                                <Grid Padding="10,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="36" Height="36"
                                            CornerRadius="18"
                                            Background="{ThemeResource AccentControlElevationFillColorDefaultBrush}">
                                        <TextBlock Text="?"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Ellipse Width="8" Height="8"
                                                     Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                            <TextBlock Text="{Binding Os}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <Grid Margin="14,12,14,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="频道"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="1"
                                Content="新建频道"
                                FontSize="12"
                                Padding="8,2"
                                Click="NewChannelButton_Click" />
                    </Grid>
                    <ListView ItemsSource="{Binding Channels.Channels}"
                              SelectedItem="{Binding Channels.SelectedChannel, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ChannelItem">
                                <Grid Padding="10,8" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="36" Height="36"
                                            CornerRadius="6"
                                            Background="{ThemeResource AccentControlElevationFillColorDefaultBrush}">
                                        <TextBlock Text="#"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Channel.Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding MemberCountText}"
                                                   FontSize="12"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="加入"
                                            FontSize="12"
                                            Padding="8,2"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsMember, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                            Click="JoinChannelButton_Click"
                                            Tag="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2"
                    Margin="12,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="SettingsButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    <TextBlock Text="设置" />
                </StackPanel>
            </Button>
        </Grid>
</UserControl>
