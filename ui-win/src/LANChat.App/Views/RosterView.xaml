<UserControl
    x:Class="LANChat.Views.RosterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LANChat.Models">
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Padding="14,16"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <StackPanel Spacing="2">
                    <TextBlock Text="联系人" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="局域网在线用户"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <ListView Grid.Row="1"
                      ItemsSource="{Binding Roster.Peers}"
                      SelectedItem="{Binding Roster.SelectedPeer, Mode=TwoWay}"
                      SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:Peer">
                        <Grid Padding="10,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="36" Height="36"
                                    CornerRadius="18"
                                    Background="{ThemeResource AccentControlElevationFillColorDefaultBrush}">
                                <TextBlock Text="?"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse Width="8" Height="8"
                                             Fill="{ThemeResource SystemFillColorSuccessBrush}" />
                                    <TextBlock Text="{Binding Os}"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Button Grid.Row="2"
                    Margin="12,8"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="SettingsButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="&#xE713;" FontFamily="{ThemeResource SymbolThemeFontFamily}" />
                    <TextBlock Text="设置" />
                </StackPanel>
            </Button>
        </Grid>
</UserControl>
