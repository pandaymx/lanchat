<UserControl
    x:Class="LANChat.Views.RosterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LANChat.Models"
    xmlns:viewmodels="using:LANChat.ViewModels">
    <Border Background="#F5F6F8"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部搜索栏 + 「+」快捷新建频道按钮 -->
            <Border Grid.Row="0"
                    Padding="12,14,12,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             PlaceholderText="搜索联系人、频道或聊天记录…"
                             CornerRadius="6"
                             FontSize="12"
                             Text="{Binding Roster.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            Content="＋"
                            Width="32"
                            Height="32"
                            Padding="0"
                            CornerRadius="6"
                            FontWeight="Bold"
                            ToolTipService.ToolTip="新建 G2 频道"
                            Click="NewChannelButton_Click" />
                </Grid>
            </Border>

            <!-- 置顶会话：📢 局域网全员广播群（G1 broadcast *） -->
            <Border Grid.Row="1"
                    Margin="8,8,8,4"
                    Padding="10,8"
                    CornerRadius="8"
                    Background="#E6F4FF"
                    BorderBrush="#B3E0FF"
                    BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Width="40"
                            Height="40"
                            CornerRadius="20"
                            Background="#0099FF">
                        <TextBlock Text="📢"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="📢 局域网全员广播群"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   Foreground="#005599" />
                        <TextBlock Text="G1 全员广播 · Swarm P2P 分发"
                                   FontSize="11"
                                   Foreground="#0077CC" />
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="进入"
                            FontSize="11"
                            Padding="8,3"
                            CornerRadius="6"
                            Background="#0099FF"
                            Foreground="White"
                            VerticalAlignment="Center"
                            Click="BroadcastSessionButton_Click" />
                </Grid>
            </Border>

            <!-- 在线好友与 G2 频道列表 -->
            <ScrollViewer Grid.Row="2" Padding="0,0,0,12">
                <StackPanel Spacing="6">
                    <!-- 在线好友分区 -->
                    <StackPanel Visibility="{Binding ShowPeersSection, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid Margin="14,10,14,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Roster.OnlineCountText}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="● P2P"
                                       FontSize="11"
                                       Foreground="#22C55E" />
                        </Grid>

                        <ListView ItemsSource="{Binding Roster.Peers}"
                                  SelectedItem="{Binding Roster.SelectedPeer, Mode=TwoWay}"
                                  SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Peer">
                                <Grid Padding="6,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 40x40 圆形 QQ 蓝头像 + 在线绿点 -->
                                    <Grid Grid.Column="0" Width="40" Height="40">
                                        <Border Width="40"
                                                Height="40"
                                                CornerRadius="20"
                                                Background="#0099FF">
                                            <TextBlock Text="{Binding AvatarInitial}"
                                                       FontSize="15"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <Border Width="11"
                                                Height="11"
                                                CornerRadius="6"
                                                Background="#22C55E"
                                                BorderBrush="White"
                                                BorderThickness="2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Nickname}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- 未读红点徽章 -->
                                    <Border Grid.Column="2"
                                            Background="#FF4D4F"
                                            CornerRadius="9"
                                            MinWidth="18"
                                            Height="18"
                                            Padding="5,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasUnread, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding UnreadBadgeText}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </StackPanel>

                    <!-- G2 频道分区 -->
                    <StackPanel Visibility="{Binding ShowChannelsSection, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid Margin="14,12,12,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="G2 频道列表"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button Grid.Column="1"
                                Content="🔄"
                                FontSize="11"
                                Padding="6,2"
                                Margin="0,0,4,0"
                                ToolTipService.ToolTip="刷新频道列表"
                                Click="RefreshChannelsButton_Click" />
                        <Button Grid.Column="2"
                                Content="＋ 新建"
                                FontSize="11"
                                Padding="8,2"
                                CornerRadius="4"
                                Click="NewChannelButton_Click" />
                    </Grid>

                    <ListView ItemsSource="{Binding Channels.Channels}"
                              SelectedItem="{Binding Channels.SelectedChannel, Mode=TwoWay}"
                              SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ChannelItem">
                                <Grid Padding="6,6" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0"
                                            Width="38"
                                            Height="38"
                                            CornerRadius="10"
                                            Background="#E6F4FF">
                                        <TextBlock Text="{Binding BadgeText}"
                                                   FontSize="15"
                                                   FontWeight="Bold"
                                                   Foreground="#0099FF"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontWeight="SemiBold"
                                                   FontSize="13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TopicSummary}"
                                                   FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="4"
                                                VerticalAlignment="Center">
                                        <Button Content="加入"
                                                FontSize="11"
                                                Padding="8,2"
                                                CornerRadius="4"
                                                Background="#0099FF"
                                                Foreground="White"
                                                Visibility="{Binding IsMember, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                Click="JoinChannelButton_Click"
                                                Tag="{Binding}" />
                                        <Border Background="#E8F8F0"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Visibility="{Binding IsMember, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="已加入"
                                                       FontSize="10"
                                                       Foreground="#16A34A"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
