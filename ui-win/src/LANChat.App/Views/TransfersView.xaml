<UserControl
    x:Name="Root"
    x:Class="LANChat.Views.TransfersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LANChat.Models">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14,16"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock Text="传输" FontSize="18" FontWeight="SemiBold" />
        </Border>

        <ScrollViewer Grid.Row="1" Padding="8">
            <ItemsControl ItemsSource="{Binding Transfers.Transfers}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:Transfer">
                        <Border Margin="4,4"
                                Padding="10"
                                CornerRadius="8"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1">
                            <StackPanel Spacing="6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis"
                                               FontWeight="SemiBold" />
                                    <Border Grid.Column="1"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="4"
                                            Padding="6,1">
                                        <TextBlock Text="{Binding Direction}" FontSize="11" />
                                    </Border>
                                </Grid>

                                <ProgressBar Minimum="0"
                                             Maximum="1"
                                             Value="{Binding Progress}" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="{Binding State}" />
                                    <TextBlock Grid.Column="1"
                                               FontSize="11"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               Text="⚠ 中继"
                                               Visibility="{Binding ViaRelay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                </Grid>

                                <Button HorizontalAlignment="Right"
                                        Content="取消"
                                        FontSize="11"
                                        Padding="10,2"
                                        Command="{Binding DataContext.Transfers.CancelCommand, ElementName=Root}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
