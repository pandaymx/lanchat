<UserControl
    x:Name="Root"
    x:Class="LANChat.Views.TransfersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:LANChat.Models">
    <Border Background="#F8F9FB"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部标题栏：📁 文件传输抽屉 -->
            <Border Grid.Row="0"
                    Padding="14,12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1">
                <StackPanel Spacing="2">
                    <TextBlock Text="📁 文件传输助手"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <TextBlock Text="P2P 直连优先 · AES-GCM 中继兜底"
                               FontSize="11"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Border>

            <!-- 传输任务卡片流 -->
            <ScrollViewer Grid.Row="1" Padding="10,8">
                <ItemsControl ItemsSource="{Binding Transfers.Transfers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:Transfer">
                            <Border Margin="0,4"
                                    Padding="12,10"
                                    CornerRadius="10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <StackPanel Spacing="8">
                                    <!-- 顶部：文件图标 + 文件名 + 方向/类型徽章 -->
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="36"
                                                Height="36"
                                                CornerRadius="8"
                                                Background="#E6F4FF"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="📄"
                                                       FontSize="16"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Padding="5,1">
                                                    <TextBlock Text="{Binding DirectionBadgeText}" FontSize="10" />
                                                </Border>
                                                <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                                        CornerRadius="4"
                                                        Padding="5,1">
                                                    <TextBlock Text="{Binding KindBadgeText}" FontSize="10" />
                                                </Border>
                                                <!-- P2P 直连绿色徽章 -->
                                                <Border Background="#E8F8F0"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        Visibility="{Binding IsDirect, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="直连"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#16A34A" />
                                                </Border>
                                                <!-- AES-GCM 中继橙色徽章 -->
                                                <Border Background="#FFF7E6"
                                                        CornerRadius="4"
                                                        Padding="6,1"
                                                        Visibility="{Binding ViaRelay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="⚠ 中继"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="#D97706" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 进度条 -->
                                    <ProgressBar Minimum="0"
                                                 Maximum="1"
                                                 Foreground="#0099FF"
                                                 Value="{Binding Progress}" />

                                    <!-- 大小进度、实时速率、群组与 Swarm 块矩阵摘要 -->
                                    <StackPanel Spacing="2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding FormattedSizeProgress}" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="#0088EE"
                                                       Text="{Binding FormattedSpeed}" />
                                        </Grid>

                                        <TextBlock FontSize="11"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Text="{Binding GroupId}"
                                                   Visibility="{Binding HasGroup, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <Border Background="#F0F4F9"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                Visibility="{Binding HasMatrix, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock FontSize="11"
                                                       FontFamily="Consolas"
                                                       Foreground="#0066CC"
                                                       Text="{Binding MatrixSummary}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- 暂停 / 继续 / 取消按钮 -->
                                    <StackPanel HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="6">
                                        <Button Content="暂停"
                                                FontSize="11"
                                                Padding="10,2"
                                                CornerRadius="4"
                                                Command="{Binding DataContext.Transfers.PauseCommand, ElementName=Root}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="继续"
                                                FontSize="11"
                                                Padding="10,2"
                                                CornerRadius="4"
                                                Command="{Binding DataContext.Transfers.ResumeCommand, ElementName=Root}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="取消"
                                                FontSize="11"
                                                Padding="10,2"
                                                CornerRadius="4"
                                                Command="{Binding DataContext.Transfers.CancelCommand, ElementName=Root}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
